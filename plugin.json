{
  "name": "ghostwriter-for-obsidian",
  "display_name": "Ghostwriter for Obsidian",
  "short_name": "Ghostwriter",
  "version": "0.7",
  "description": "Filesystem-native AI collaboration and co-authorship for Obsidian vaults",
  "author": "Draxall",
  "license": "MIT",
  "icon": "🖋️",
  "default_enabled": true,
  "settingsUI": "auto",
  "capabilities": {
    "tools": [
      "tools/ghostwriter_tools.py"
    ],
    "settings": [
      {
        "key": "vault_path",
        "type": "string",
        "label": "Obsidian Vault Path",
        "default": "",
        "help": "Path to the Obsidian vault Ghostwriter should access."
      }
    ],
    "routes": [
      {
        "method": "GET",
        "path": "status",
        "handler": "routes/status.py:handle"
      },
      {
        "method": "POST",
        "path": "list",
        "handler": "routes/list.py:handle"
      },
      {
        "method": "POST",
        "path": "read",
        "handler": "routes/read.py:handle"
      },
      {
        "method": "POST",
        "path": "folder/create",
        "handler": "routes/write.py:create_folder"
      },
      {
        "method": "POST",
        "path": "note/create",
        "handler": "routes/write.py:create_note"
      }
    ]
  }
}